{
  "name": "fithub",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "test:performance-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/performance-audit.test.mjs",
    "performance:benchmark": "node scripts/benchmark-performance.mjs",
    "performance:dependencies": "node scripts/audit-dependencies.mjs",
    "performance:syntax": "node scripts/check-typescript-syntax.mjs",
    "test:notifications-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/notifications-linking.test.mjs",
    "test:offline-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/offline-capability.test.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --watchAll=false",
    "test:coverage": "jest --watchAll=false --runInBand --coverage --json --outputFile=artifacts/jest-results.json",
    "test:integration": "jest --watchAll=false --runInBand --testPathPattern=integration",
    "production:config": "expo config --type public",
    "production:dependencies": "expo install --check",
    "production:android": "expo export --platform android --output-dir artifacts/export-android",
    "production:ios": "expo export --platform ios --output-dir artifacts/export-ios",
    "test:core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/*.test.mjs",
    "test:verify": "node scripts/run-test-verification.mjs",
    "test:report": "node scripts/create-test-report.mjs",
    "test:database": "node scripts/run-database-tests.mjs",
    "test:e2e:provision": "node scripts/provision-e2e-user.mjs",
    "test:e2e": "maestro test --format junit --output artifacts/maestro-results.xml .maestro",
    "test:watch": "jest --watch",
    "test:ui-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/ui-polish.test.mjs",
    "db:verify": "node scripts/verify-database.mjs",
    "test:exercise-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/exercise-library.test.mjs",
    "test:workout-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/workout-management.test.mjs",
    "test:tracking-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/workout-tracking.test.mjs",
    "test:social-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/social-friends.test.mjs",
    "test:challenge-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/fitness-challenges.test.mjs",
    "test:leaderboard-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/leaderboards.test.mjs",
    "test:progress-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/body-progress.test.mjs",
    "test:photo-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/progress-photos.test.mjs",
    "test:achievement-core": "node --experimental-vm-modules --test --test-isolation=none scripts/tests/achievements.test.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.0",
    "@hookform/resolvers": "^5.2.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.1.8",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/query-async-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "expo": "~57.0.27",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.65.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "resolver": "react-native-worklets/jest/resolver",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.expo/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/__tests__/**",
      "!src/**/testing/**",
      "!src/testing/**",
      "!src/**/*.d.ts",
      "!src/**/types/**",
      "!src/types/**"
    ],
    "coverageDirectory": "artifacts/coverage",
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    },
    "testTimeout": 10000
  }
}
